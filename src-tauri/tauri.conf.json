{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wallpaper-tauri",
  "version": "0.1.0",
  "identifier": "com.zhouchang.wallpaper-tauri",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "wallpaper-tauri",
        "width": 1440,
        "height": 900,
        "decorations": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../saver/build/WallpaperTauri.saver": "WallpaperTauri.saver"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
